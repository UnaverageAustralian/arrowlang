import std::errors

$main ( -> u8 )
    2 3 + 5  = "2 3 + = 5"  std::errors::assert
    2 3 - -1 = "2 3 - = -1" std::errors::assert |
    2 3 * 6  = "2 3 * = 6"  std::errors::assert |
    5 3 / 1  = "5 3 / = 1"  std::errors::assert |
    5 3 % 2  = "5 3 % = 2"  std::errors::assert |
    5 neg -5 = "5 neg = -5" std::errors::assert |

    5 -3 / -1 = "5 -3 / = -1" std::errors::assert |
    5 -3 % 2  = "5 -3 % = 2"  std::errors::assert |

    -5 -3 / 1  = "-5 -3 / = 1"  std::errors::assert |
    -5 -3 % -2 = "-5 -3 % = -2" std::errors::assert |
$
