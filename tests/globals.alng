import errors

struct Foo
    x : i32
    y : i32
end

global x : u64
global foo : Foo

$main ( -> u8 )
    x 10 => drop
    x.@ 10 = "x = 10" errors::assert
    x 20 => drop
    x.@ 20 = "x = 20" errors::assert |

    foo (200 400 Foo) => drop
    foo.x 200 = "foo.x = 200" errors::assert |
    foo.y 400 = "foo.y = 400" errors::assert |

    foo (600 800 Foo) => drop
    foo.x 600 = "foo.x = 600" errors::assert |
    foo.y 800 = "foo.y = 800" errors::assert |
$
