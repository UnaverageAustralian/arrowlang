module modules

import std::io
import std::errors
import modules::funcs

$print ( str )
    printsln
$

$verify ( -> u8 )
    2.0 3.0 funcs::addmul .@ 15.0 = "2.0 +* 3.0 = 15.0" errors::assert
    6.0 3.0 funcs::subdiv .@ 1.0  = "6.0 -/ 3.0 = 1.0"  errors::assert |
    if dup ! then "Works!" else "Fix immediately" end print
$

$main ( -> u8 )
    verify
$
