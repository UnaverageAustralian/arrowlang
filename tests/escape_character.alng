import std::errors

$main ( -> u8 )
    '\a' 7   = "'\\a' = 7"   std::errors::assert
    '\b' 8   = "'\\b' = 8"   std::errors::assert |
    '\t' 9   = "'\\t' = 9"   std::errors::assert |
    '\n' 10  = "'\\n' = 10"  std::errors::assert |
    '\v' 11  = "'\\v' = 11"  std::errors::assert |
    '\f' 12  = "'\\f' = 12"  std::errors::assert |
    '\r' 13  = "'\\r' = 13"  std::errors::assert |
    '\e' 27  = "'\\e' = 27"  std::errors::assert |
    '\"' 34  = "'\\\"' = 34" std::errors::assert |
    '\'' 39  = "'\\'' = 39"  std::errors::assert |
    '\\' 92  = "'\\\\' = 92" std::errors::assert |
    '\p' 112 = "'\\p' = 112" std::errors::assert |

    '\0'   0   = "'\\0'   = 0"   std::errors::assert |
    '\145' 101 = "'\\145' = 101" std::errors::assert |
    '\x65' 101 = "'\\x65' = 101" std::errors::assert |
$
