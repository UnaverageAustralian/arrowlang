import std::errors

struct Foo
    x : i32
end

$foo ( ptr[Foo] -> ptr[Foo] )
    20 >#x
$

$bar ( Foo -> Foo )
    9 >#x
$

$main ( -> u8 )
    3 Foo ptr[Foo]        #x 3  = "#x = 3"  std::errors::assert
    swap 4 Foo =>         #x 4  = "#x = 4"  std::errors::assert rot |
    swap 5 Foo 1 +=> 1 +@ .x 5  = "#x = 5"  std::errors::assert rot |
    swap   foo            #x 20 = "#x = 20" std::errors::assert rot |
    swap .@ bar           #x 9  = "#x = 9"  std::errors::assert rot |
    swap ptr[Foo] dup 5 + - u64 5 = "dup 5 +@ - = 5" std::errors::assert |

    "Hello, World!" 1 +@ 'e' = "\"Hello, World!\" 1 +@ = 'e'" std::errors::assert rot | ldrop

    alloc i32 10 => .@ 10 = "alloc i32 10 => @ = 10" std::errors::assert |
$
