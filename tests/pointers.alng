import errors

struct Foo
    x : i32
end

$foo ( ptr[Foo] -> ptr[Foo] )
    20 >#x
$

$bar ( Foo -> Foo )
    9 >#x
$

$main ( -> u8 )
    3 Foo ptr[Foo]       #x 3  = "#x = 3"  errors::assert
    swap 4 Foo =>        #x 4  = "#x = 4"  errors::assert rot |
    swap 5 Foo 1 +=> 1 +@.x 5  = "#x = 5"  errors::assert rot |
    swap   foo           #x 20 = "#x = 20" errors::assert rot |
    swap .@ bar          #x 9  = "#x = 9"  errors::assert rot |

    swap ptr[Foo] dup 5 + - 5 = "dup 5 +@ - = 5" errors::assert |
$
